{
  "name": "impact-log",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://impact-log.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxmvshnvsk/impact-log.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
