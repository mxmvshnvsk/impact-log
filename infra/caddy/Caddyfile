# DOMAIN задаётся в .env (impact-log.com). Для локальной проверки образа: DOMAIN=localhost
{$DOMAIN:localhost} {
	encode zstd gzip

	# Логи доступа: IP усечены (IPv4 /24, IPv6 /48), заголовки (cookie, user-agent…) не пишутся — ADR-0001
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers delete
				resp_headers delete
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# Sourcemaps лежат в образе для отладки, но наружу не отдаются
	@sourcemaps path *.map
	handle @sourcemaps {
		respond 404
	}

	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html (в т.ч. отданный на любой путь SPA) — всегда перепроверять
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# PWA (docs/pwa.md): service worker и манифест тоже всегда перепроверяются — иначе браузер
		# может не увидеть новую версию приложения. Отдельным правилом, чтобы не потерять при правках выше
		@pwa path /sw.js /manifest.webmanifest
		header @pwa Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"

		# SPA: неизвестные пути отдаём index.html (vue-router, history mode)
		try_files {path} /index.html
		file_server
	}
}

www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
