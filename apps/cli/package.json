{
  "name": "impact-log",
  "type": "module",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "homepage": "https://impact-log.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mxmvshnvsk/impact-log.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/mxmvshnvsk/impact-log/issues"
  },
  "description": "Capture what you did and its impact from the terminal: drafts open in impact log, nothing is sent to a server",
  "keywords": [
    "impact",
    "brag document",
    "performance review",
    "self-review",
    "achievements",
    "work log",
    "career",
    "cli",
    "git"
  ],
  "bin": {
    "impact": "./dist/impact.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "package": "pnpm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@impact-log/core": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
