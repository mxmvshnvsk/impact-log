# Прод-окружение: скопировать в /opt/impact-log/.env на сервере и заполнить.
# Локально .env не нужен — api по умолчанию ходит в Postgres из docker-compose.dev.yml.

# Домен, для которого Caddy получает TLS-сертификат
DOMAIN=impact-log.com

# Логин/организация на GitHub в нижнем регистре (образы: ghcr.io/<owner>/impact-log-api|web)
GHCR_OWNER=your-github-login
IMAGE_TAG=latest

# Postgres. Пароль — только URL-безопасные символы, например: openssl rand -hex 24
POSTGRES_USER=impact
POSTGRES_PASSWORD=change-me
POSTGRES_DB=impact

# Ключ шифрования TOTP-секретов (32 байта hex): openssl rand -hex 32
# ВАЖНО: не менять после появления пользователей — иначе их 2FA перестанет работать.
TOTP_ENCRYPTION_KEY=

# false — закрыть регистрацию новых пользователей
REGISTRATION_ENABLED=true
